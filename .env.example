DATABASE_URL=postgresql://user:password@localhost:5432/cerilas
JWT_SECRET=replace-with-a-long-random-secret
VAULT_ENCRYPTION_KEY=replace-with-a-separate-long-random-secret
VAULT_ACCESS_TOKEN_SECRET=replace-with-another-long-random-secret
ACCOUNTS_VAULT_PASSWORD=replace-with-a-strong-vault-password
CRON_SECRET=replace-with-a-separate-long-random-secret

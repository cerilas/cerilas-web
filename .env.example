GEMINI_API_KEY=
# Ücretsiz Gemini kotasında 20 RPM sınırını aşmamak için istekler arası minimum süre.
GEMINI_MIN_REQUEST_INTERVAL_MS=3500
OPPORTUNITY_SCANNER_ENABLED=true
PORT=3001
